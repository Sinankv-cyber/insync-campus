{
  "name": "insync",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3333 --hostname localhost",
    "build": "next build",
    "start": "next start --port 3333",
    "lint": "eslint",
    "db:migrate": "tsx --env-file=.env.local --conditions=react-server scripts/db.ts migrate",
    "db:seed": "tsx --env-file=.env.local --conditions=react-server scripts/db.ts seed",
    "db:check": "tsx --env-file=.env.local --conditions=react-server scripts/db.ts check",
    "db:rebrand": "tsx --env-file=.env.local --conditions=react-server scripts/db.ts rebrand"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.3",
    "arctic": "^3.7.0",
    "bcryptjs": "^3.0.3",
