# Copy to .env.local and fill in. Never commit real values.

# Storage backend: "neon" (Postgres via DATABASE_URL) or "sqlite" (local demo file, Node 22.5+)
STORAGE_DRIVER=neon
# Neon Postgres connection string
DATABASE_URL=
# Optional: SQLite file path when STORAGE_DRIVER=sqlite (default .data/hostelpass.sqlite)
SQLITE_PATH=

# Session encryption secret, at least 32 random characters
AUTH_SECRET=
# Public base URL of the app (no trailing slash)
APP_URL=http://localhost:3333
# Shared secret for /api/cron/evaluate (Vercel sends it as a Bearer token)
CRON_SECRET=

# Web push keys: generate with `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, e.g. mailto:admin@example.com
VAPID_SUBJECT=

# Google OAuth client; redirect URI is <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
